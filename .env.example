# ===== FitBro AI — cấu hình (copy thành .env rồi điền) =====

# Chuỗi ngẫu nhiên dài để ký token đăng nhập (BẮT BUỘC đổi khi deploy)
# Tạo nhanh: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# ----- Mô hình AI (chuẩn OpenAI-compatible) -----
# Ví dụ:
#   OpenAI     : LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4o-mini
#   Gemini     : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ LLM_MODEL=gemini-2.5-flash
#   OpenRouter : LLM_BASE_URL=https://openrouter.ai/api/v1                           LLM_MODEL=openai/gpt-4o-mini
#   Groq       : LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
#   Ollama     : LLM_BASE_URL=http://localhost:11434/v1                              LLM_MODEL=qwen2.5:7b (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# (tuỳ chọn) key dự phòng — nên tạo ở project Google Cloud KHÁC để có hạn mức riêng; phẩy ngăn cách
LLM_BACKUP_API_KEYS=
LLM_MODEL=gpt-4o-mini
# (tuỳ chọn) model rẻ/nhanh cho bước Router, model đọc ảnh riêng
LLM_FAST_MODEL=
LLM_VISION_MODEL=
LLM_TEMPERATURE=0.4
# Tắt nếu API không hỗ trợ function calling / JSON mode
LLM_SUPPORTS_TOOLS=true
LLM_JSON_MODE=true
# Gợi ý 3 câu hỏi tiếp theo sau mỗi câu trả lời (tốn thêm 1 lần gọi model nhanh)
# Giảm mức "suy nghĩ" để trả lời nhanh hơn: low | medium | high (trống = mặc định của model)
LLM_REASONING_EFFORT=
# Model dự phòng khi model chính hết hạn mức (429), phẩy ngăn cách — hữu ích với gói miễn phí
LLM_FALLBACK_MODELS=
LLM_FOLLOWUPS=true
# Số tin nhắn AI tối đa mỗi người mỗi ngày (kiểm soát chi phí)
CHAT_DAILY_LIMIT=150

# ----- (tuỳ chọn) Nhà cung cấp THỨ 2: dự phòng khi model chính lỗi/hết hạn mức + đọc ảnh -----
# Ví dụ model chính là Mercury (chỉ đọc chữ) thì dùng Gemini ở đây để phân tích ảnh món ăn / phiếu InBody.
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_API_KEYS=
SECONDARY_LLM_MODELS=
SECONDARY_LLM_REASONING_EFFORT=
LLM_VISION_USE_SECONDARY=false

# ----- Database -----
# Bỏ trống = SQLite (file backend/fitbro.db). Khi deploy nên dùng Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=

# ----- Đăng nhập Google (tuỳ chọn) -----
# Tạo OAuth Client ID loại "Web application" tại https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:8000 , http://localhost:5173 , https://<domain-cua-ban>
GOOGLE_CLIENT_ID=

# ----- Khác -----
ENVIRONMENT=development
TIMEZONE=Asia/Ho_Chi_Minh
# Chỉ cần khi frontend chạy ở domain khác backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Guardrails -----
# Câu "lưng chừng" mà regex không chắc → hỏi thêm model nhanh để phân loại rủi ro (tốn thêm ~1 lượt gọi cho các câu đó)
GUARD_LLM_CLASSIFIER=true
# Kiểm tra câu trả lời của agent: calo quá thấp, giảm cân quá nhanh, chẩn đoán, liều thuốc, lộ prompt
GUARD_OUTPUT=true

# ----- RAG (kho kiến thức backend/data/knowledge) -----
# Trống = dùng nhà cung cấp thứ 2 (Gemini) để embed. Không có embedding vẫn chạy bằng BM25.
# Sửa kho kiến thức xong chạy: python backend/scripts/build_knowledge_index.py
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_ENABLED=true

# ----- Observability (trang Nhật ký AI) -----
# Email được xem nhật ký AI của TOÀN hệ thống (phẩy ngăn cách); người khác chỉ xem lượt chat của mình
ADMIN_EMAILS=
TRACE_RETENTION_DAYS=30
