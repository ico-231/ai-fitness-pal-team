<mxfile host="FitBro" type="device"><diagram id="p8" name="8. Human-in-the-loop: ghi bữa ăn qua chat (sơ đồ tuần tự)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="8. Human-in-the-loop: ghi bữa ăn qua chat (sơ đồ tuần tự)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Agent không tự ghi dữ liệu: propose_meal_log chỉ tạo PendingAction + thẻ xác nhận; bữa ăn chỉ được lưu khi người dùng bấm Xác nhận." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;size=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fillColor=#1E3A8A;fontColor=#FFFFFF;strokeColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="140" height="790" as="geometry"/></mxCell><mxCell id="c4" value="Giao diện" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;size=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="175" y="110" width="140" height="790" as="geometry"/></mxCell><mxCell id="c5" value="FastAPI" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=0;collapsible=0;size=44;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="140" height="790" as="geometry"/></mxCell><mxCell id="c6" value="Orch