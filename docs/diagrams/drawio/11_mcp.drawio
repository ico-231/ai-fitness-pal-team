<mxfile host="FitBro" type="device"><diagram id="p11" name="11. Kiến trúc MCP server"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="11. Kiến trúc MCP server" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="FitBro mở công cụ chỉ đọc theo chuẩn Model Context Protocol cho mọi MCP client, với model bất kỳ. FitBro vẫn chạy đầy đủ khi không dùng MCP." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="MCP client bất kỳ" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="280" height="300" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Ứng dụng chat&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;hỗ trợ MCP&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="c3"><mxGeometry x="20" y="45" width="240" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Trình soạn code&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;IDE có MCP&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="c3"><mxGeometry x="20" y="1