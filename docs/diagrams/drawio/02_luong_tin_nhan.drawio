<mxfile host="FitBro" type="device"><diagram id="p2" name="2. Luồng xử lý một tin nhắn"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="2. Luồng xử lý một tin nhắn" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Guard đầu vào → Router → 1-2 agent (vòng lặp ReAct với công cụ) → guard đầu ra → lưu, stream về giao diện. Mọi bước được ghi trace." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Tin nhắn&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;(+ ảnh, + ngữ cảnh trang)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=40;fillColor=#1E3A8A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="180" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Guard luật&lt;br&gt;(regex)" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rhombus;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="160" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Trả lời hướng dẫn an toàn&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;115 · đường dây hỗ trợ&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;KHÔNG gọi model&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="1"><mxGeometry x="640" y="205" width="240" height="80" as="geometry"/></mxCell><mxCell id="c6" value="LLM phân loại&lt;br&gt;câu lưng chừng" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rhombus;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="170" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Gắn ghi chú cho agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;thận trọng y tế · prompt injection&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;ăn kiêng cực đoan&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="200" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;từ khoá → LLM (JSON)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="180" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Vòng lặp ReAct · tối đa 6 lượt" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#FFFFFF;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="555" width="400" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Gọi model&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;kèm công cụ được phép&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="c9"><mxGeometry x="20" y="45" width="16