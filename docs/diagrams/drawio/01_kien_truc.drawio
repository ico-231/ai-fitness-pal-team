&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;Guardrails → Router → HeadBro / CoachBro / NutriBro&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;→ Tổng kết · 31 công cụ&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="c8"><mxGeometry x="380" y="45" width="330" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;MCP server (tuỳ chọn)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;22 công cụ chỉ đọc + ask_fitbro&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#64748B;dashed=1;" vertex="1" parent="c8"><mxGeometry x="740" y="45" width="300" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;công thức · thống kê · bài tập · món Việt&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;lịch tập · insights&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c8"><mxGeometry x="20" y="165" width="330" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Kho kiến thức RAG&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;68 đoạn có nguồn + vector&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;shape=document;boundedLbl=1;size=0.18;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="c8"><mxGeometry x="740" y="165" width="150" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;observability&lt;/font&gt