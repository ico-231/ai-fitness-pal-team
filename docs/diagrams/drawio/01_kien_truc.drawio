<mxfile host="FitBro" type="device"><diagram id="p1" name="1. Kiến trúc tổng thể FitBro AI"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="1. Kiến trúc tổng thể FitBro AI" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Một server FastAPI phục vụ cả API và giao diện React. Tầng AI gọi model qua chuẩn OpenAI-compatible (2 nhà cung cấp). Camera AI chạy ngay trên trình duyệt. MCP server là thành phần tuỳ chọn." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=40;fillColor=#1E3A8A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="160" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Frontend · React 19 + Vite + Tailwind (trình duyệt)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="1060" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;10 trang giao diện&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;Dashboard · Trợ lý AI · Workouts · Daily · Nutrition&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;InBody · Hướng dẫn · Cài đặt · Nhật ký AI&l