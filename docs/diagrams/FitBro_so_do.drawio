ào DB sau bước này&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="330" y="610" width="500" height="60" as="geometry"/></mxCell><mxCell id="c21" value="thẻ xác nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="Agent nào gọi công cụ không thuộc quyền của mình sẽ bị từ chối (run_tool kiểm tra danh sách agent của từng công cụ)." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1040" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Guardrails 4 lớp"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="5. Guardrails 4 lớp" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Lớp 1-2 lọc đầu vào, lớp 3 chặn ngay trong công cụ, lớp 4 soát câu trả lời trước khi lưu và hiển thị." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Tin nhắn" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=40;fillColor=#1E3A8A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="120" height="50" as="geometry"/></mxCell><mxCell id="c4" value="① Luật đầu vào (regex)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="220" height="300" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;CHẶN&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;cấp cứu · khủng hoảng tâm lý&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;rối loạn ăn uống · chất cấm&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;" vertex="1" parent="c4"><mxGeometry x="15" y="45" width="190" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;GHI CHÚ&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;thận trọng y tế · prompt injection&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;ăn kiêng cực đoan&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="c4"><mxGeometry x="15" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c7" value="② LLM phân loại" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="220" height="300" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Chỉ với câu lưng chừng&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;label + confidence&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;chặn khi ≥ 0,8&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c7"><mxGeometry x="15" y="45" width="190" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Ví dụ bắt được&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;“sống chẳng còn ý nghĩa gì”&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;shape=note;size=14;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="c7"><mxGeometry x="15" y="160" width="190" height="80" as="geometry"/></mxCell><mxCell id="c10" value="③ Trong công cụ" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="220" height="300" as="geometry"/></mxCell><mxCell id="c11" value="propose_goal từ chối giảm cân &gt; ~1,25%/tuần" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c10"><mxGeometry x="15" y="40" width="190" height="54" as="geometry"/></mxCell><mxCell id="c12" value="remember từ chối câu lệnh (memory poisoning)" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c10"><mxGeometry x="15" y="104" width="190" height="54" as="geometry"/></mxCell><mxCell id="c13" value="Ghi dữ liệu luôn chờ người dùng xác nhận" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c10"><mxGeometry x="15" y="168" width="190" height="54" as="geometry"/></mxCell><mxCell id="c14" value="MCP chỉ mở công cụ đọc" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c10"><mxGeometry x="15" y="232" width="190" height="44" as="geometry"/></mxCell><mxCell id="c15" value="④ Soát câu trả lời" style="swimlane;startSize=30;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=15;fontColor=#0F172A;swimlaneFillColor=#F8FAFC;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="220" height="300" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Phát hiện&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;calo &lt; 1200/1500 · giảm cân quá nhanh&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;nhịn ăn nhiều ngày · chẩn đoán&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;liều thuốc · lộ prompt&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="c15"><mxGeometry x="15" y="45" width="190" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Xử lý&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;nối “Lưu ý an toàn”&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#475569&#x27;&gt;lộ prompt → thay cả câu&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontColor=#0F172A;fontSize=14;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#16A34A;" vertex="1" parent="c15"><mxGeometry x="15" y="175" width="190" height="80" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;fontColor=#334155;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;endArrow=block;endFill=1;endSize=7;" edge="1" parent=